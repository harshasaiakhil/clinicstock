# ==============================================================================
# ClinicStock Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env) and customize values.
# NEVER commit production credentials or actual secret keys to version control.
# ==============================================================================

# Backend Database Configuration (Supports Local PostgreSQL & Neon PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicstock

# Security & JWT Authentication
# Generate a strong key in production via: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated allowed browser origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Frontend API Configuration (Vite)
VITE_API_URL=http://127.0.0.1:8000/api/v1
